# Sample data: the directory is tracked (with a .gitkeep) so the
# structure is reproducible across clones, but its audio contents are
# user-supplied and never committed.
LocalLibraryManager.sampleData/*
!LocalLibraryManager.sampleData/.gitkeep
!LocalLibraryManager.sampleData/README.md

# Library search index runtime artifacts (SQLite + WAL sidecars) — created
# next to song_cache/ by the backend at runtime, never committed.
backend/library_index.db
backend/library_index.db-wal
backend/library_index.db-shm
